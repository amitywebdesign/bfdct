{
  "name": "bfdct",
  "version": "1.0.0",
  "private": true,
  "description": "Website for the Bethany Volunteer Fire Department (Bethany, CT). Eleventy builds plain HTML.",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "check": "eleventy && node scripts/check.mjs",
    "build:offline": "cross-env OFFLINE=1 eleventy",
    "build:pages": "cross-env PAGES=1 eleventy",
    "check:pages": "cross-env PAGES=1 eleventy && cross-env PAGES=1 node scripts/check.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "7.0.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "cross-env": "10.1.0",
    "luxon": "3.7.2"
  }
}
