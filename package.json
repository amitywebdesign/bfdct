{
  "name": "bfdct",
  "version": "1.0.0",
  "private": true,
  "description": "Website for the Bethany Volunteer Fire Department (Bethany, CT). Eleventy builds plain HTML.",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "ELEVENTY_RUN_MODE=build eleventy",
    "check": "ELEVENTY_RUN_MODE=build eleventy && node scripts/check.mjs",
    "build:offline": "OFFLINE=1 ELEVENTY_RUN_MODE=build eleventy",
    "clean": "rm -rf _site _offline .cache"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "7.0.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "luxon": "3.7.2"
  }
}
