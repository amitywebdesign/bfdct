<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  {%- if env.pages %}
  {#- GitHub Pages cannot send headers, so the CSP and referrer policy go here. Must stay ahead of any script or style. #}
  <meta http-equiv="Content-Security-Policy" content="{{ csp.meta }}">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {%- endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set fullTitle = site.name + " | Bethany, CT" if page.url == "/" else title + " | " + site.shortName %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl(siteUrl) }}">
  {%- if noindex or env.staging %}<meta name="robots" content="noindex">{% endif %}
  <meta name="theme-color" content="#23262b">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(siteUrl) }}">
  <meta property="og:image" content="{{ (ogImage or '/assets/img/og-default.png') | absoluteUrl(siteUrl) }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/source-sans-3-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="/assets/js/init.js"></script>
  {%- if page.url == "/" %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "FireStation",
    "name": site.name,
    "url": siteUrl + "/",
    "telephone": site.phone | tel,
    "slogan": site.tagline,
    "description": "Volunteer fire department and ambulance corps serving Bethany, Connecticut since 1934. Members meet at Headquarters every Tuesday at 7pm.",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": site.address.street,
      "addressLocality": site.address.city,
      "addressRegion": site.address.state,
      "postalCode": site.address.zip,
      "addressCountry": "US"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": site.geo.lat, "longitude": site.geo.lon },
    "foundingDate": "1934-09-24"
  } | json | safe }}</script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
  {%- if site.analytics.plausibleDomain %}
  <script defer data-domain="{{ site.analytics.plausibleDomain }}" src="https://plausible.io/js/script.js"></script>
  {%- endif %}
</body>
</html>
