---
layout: layouts/page.njk
title: News
section:
eyebrow: News
heading: News
lead: Updates, thank-yous, and notes from the Chief.
description: "News from the Bethany Volunteer Fire Department: event recaps, welcomes, thank-yous, and notes from the Chief."
---
<section class="section">
  <div class="container narrow">
    {%- if collections.news.length %}
    <ul class="news-list">
      {%- for post in collections.news %}
      <li class="news-item"><h2 class="news-h"><a href="{{ post.url }}">{{ post.data.title }}</a></h2><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLong }}</time><p>{{ post.data.summary }}</p></li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="lead">Updates will be posted here. Come to a <a href="/join/">Tuesday night</a> and you'll hear it first.</p>
    {%- endif %}
  </div>
</section>
